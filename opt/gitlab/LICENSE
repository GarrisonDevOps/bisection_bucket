  testing_test.go - github.com/hashicorp/golang-lru/v2
  // Copyright (c) HashiCorp, Inc.
  // SPDX-License-Identifier: MPL-2.0
  package lru
  import (
  	"crypto/rand"
  	"math"
  	"math/big"
  	"testing"
  )
  func getRand(tb testing.TB) int64 {
  	out, err := rand.Int(rand.Reader, big.NewInt(math.MaxInt64))
  	if err != nil {
  		tb.Fatal(err)
  	}
  	return out.Int64()
  }
