  procfs_linux_test.go - github.com/cyphar/filepath-securejoin/pathrs-lite/procfs
  // SPDX-License-Identifier: MPL-2.0
  //go:build linux
  // Copyright (C) 2024-2025 Aleksa Sarai <cyphar@cyphar.com>
  // Copyright (C) 2024-2025 SUSE LLC
  //
