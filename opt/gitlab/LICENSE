  		s, err := client.Open(context.Background())
  		if err == nil {
  			s.Close()
  			time.Sleep(50 * time.Millisecond)
  			continue
  		}
  		if err != ErrRemoteGoAway {
  			t.Fatalf("expected %s, got %s", ErrRemoteGoAway, err)
  		} else {
  			return
  		}
  	}
  	t.Fatalf("expected GoAway error")
  }
