  package gopathrs_test
  import (
  	"fmt"
  	"os"
  	"testing"
  	"github.com/stretchr/testify/assert"
  	"github.com/stretchr/testify/require"
  	"golang.org/x/sys/unix"
  	"github.com/cyphar/filepath-securejoin/pathrs-lite/internal/gopathrs"
