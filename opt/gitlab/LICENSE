            cd /tmp/libpathrs
            wget -O latest.tar.gz "${{ steps.libpathrs-release-tarball.outputs.result }}"
            tar xvf latest.tar.gz
            cd *libpathrs-*/
            make release
            sudo ./install.sh --libdir=/usr/lib
