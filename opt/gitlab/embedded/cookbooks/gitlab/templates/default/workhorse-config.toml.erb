<%- if @alt_document_root %>
alt_document_root = "<%= @alt_document_root %>"
<%- end %>
<%- if @shutdown_timeout %>
shutdown_timeout = "<%= @shutdown_timeout %>"
<%- end %>
<%- if @trusted_cidrs_for_propagation %>
trusted_cidrs_for_propagation = <%= @trusted_cidrs_for_propagation.to_json %>
<%- end %>
<%- if @trusted_cidrs_for_x_forwarded_for %>
trusted_cidrs_for_x_forwarded_for = <%= @trusted_cidrs_for_x_forwarded_for.to_json %>
<%- end %>

<%- if @extra_config_command %>
config_command = "<%= @extra_config_command %>"
<%- end %>

<%- if @workhorse_keywatcher %>
[redis]
<%- if @redis_credentials_provider %>
<%# Auth is supplied by the credentials provider below; no static user/password. %>
<%- else %>
<%- if @username %>
Username = "<%= @username %>"
<%- end %>
Password = "<%= @password %>"
<%- end %>
<%- if @sentinels.empty? %>
URL = "<%= @redis_url %>"
<%- else %>
Sentinel = <%= @sentinels.to_json %>
SentinelMaster = "<%= @sentinel_master %>"
<%- if @sentinel_username %>
SentinelUsername = "<%= @sentinel_username %>"
<%- end %>
SentinelPassword = "<%= @sentinel_password %>"
<%- if @sentinels_ssl %>
[Sentinel.tls]
<%- if @sentinel_tls_options %>
<%- %i[certificate key ca_certificate].each do |key| %>
  <%- value = @sentinel_tls_options[key] %>
  <%- if value %>
  <%= key %> = "<%= "#{value}" %>"
  <%- end %>
<%- end %>
<%- end %>
<%- end %>
<%- end %>
<%- if @redis_tls_options %>
[redis.tls]
<%- %i[certificate key ca_certificate].each do |key| %>
  <%- value = @redis_tls_options[key] %>
  <%- if value %>
  <%= key %> = "<%= "#{value}" %>"
  <%- end %>
<%- end %>
<%- end %>
<%- if @redis_credentials_provider %>
[redis.credentials_provider]
provider = "<%= @redis_credentials_provider['provider'] %>"
[redis.credentials_provider.azure]
auth_type = "<%= @redis_credentials_provider['auth_type'] %>"
<%- if @redis_credentials_provider['object_id'] && !@redis_credentials_provider['object_id'].to_s.empty? %>
object_id = "<%= @redis_credentials_provider['object_id'] %>"
<%- end %>
scope = "<%= @redis_credentials_provider['scope'] %>"
<%- end %>
<%- end %>

<%- if @object_store_toml %>
<%= @object_store_toml %>
<%- end %>

[image_resizer]
  max_scaler_procs = <%= @image_scaler_max_procs %>
  max_filesize = <%= @image_scaler_max_filesize %>

<%- unless @metadata_zip_reader_limit_bytes.nil? %>
[metadata]
  <%- if @metadata_zip_reader_limit_bytes %>
  zip_reader_limit_bytes = <%= @metadata_zip_reader_limit_bytes %>
  <%- end %>
<%- end %>
