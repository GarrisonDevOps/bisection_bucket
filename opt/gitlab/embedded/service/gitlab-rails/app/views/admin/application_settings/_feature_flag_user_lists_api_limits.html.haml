= render ::Layouts::SettingsBlockComponent.new(_('Feature flag user lists API rate limits'),
  id: 'js-feature-flag-user-lists-api-limits-settings',
  expanded: expanded_by_default?) do |c|
  - c.with_description do
    = _('Limit the bytes of feature flag user lists a user can create or update per minute through API requests.')
    = link_to _('Learn more.'), help_page_path('rate_limits/api/feature-flag-user-lists.md'), target: '_blank', rel: 'noopener noreferrer'
  - c.with_body do
    = gitlab_ui_form_for @application_setting, url: network_admin_application_settings_path(anchor: 'js-feature-flag-user-lists-api-limits-settings'), html: { class: 'fieldset-form' } do |f|
      = form_errors(@application_setting)

      %fieldset
        .form-group
          = f.label :feature_flag_user_list_write_bytes_limit_per_user, _('Maximum bytes of user lists written per minute per user'), class: 'label-bold'
          = f.number_field :feature_flag_user_list_write_bytes_limit_per_user, min: 0, class: 'form-control gl-form-input'
          .form-text.gl-text-subtle
            = _('Set to 0 to disable the limit.')

      = f.submit _('Save changes'), pajamas_button: true
