= render ::Layouts::SettingsBlockComponent.new(s_('PushRateLimits|Git push rate limits'),
  id: 'js-git-push-limits-settings',
  testid: 'git-push-limits',
  expanded: expanded_by_default?) do |c|
  - c.with_description do
    = s_('PushRateLimits|Limit the number of Git pushes to each project every minute, over HTTPS and SSH.')
    = link_to _('Learn more.'), help_page_path('rate_limits/git.md', anchor: 'git-push-operations'), target: '_blank', rel: 'noopener noreferrer'
  - c.with_body do
    = gitlab_ui_form_for @application_setting, url: network_admin_application_settings_path(anchor: 'js-git-push-limits-settings'), html: { class: 'fieldset-form' } do |f|
      = form_errors(@application_setting)

      %fieldset
        .form-group
          = f.label :git_push_per_project_limit, s_('PushRateLimits|Maximum number of pushes every minute for each project'), class: 'gl-font-bold'
          = f.number_field :git_push_per_project_limit, min: 0, class: 'form-control gl-form-input'
          %span.form-text.gl-text-subtle= _('Set to 0 to disable the limit.')
      = f.submit _('Save changes'), pajamas_button: true
