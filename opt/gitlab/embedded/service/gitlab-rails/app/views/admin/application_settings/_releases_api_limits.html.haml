= render ::Layouts::SettingsBlockComponent.new(_('Releases API rate limits'),
  id: 'js-releases-api-limits-settings',
  expanded: expanded_by_default?) do |c|
  - c.with_description do
    = _('Limit the number of release creates, updates, and evidence collections per minute through API requests.')
    = link_to _('Learn more.'), help_page_path('rate_limits/api/releases.md'), target: '_blank', rel: 'noopener noreferrer'
  - c.with_body do
    = gitlab_ui_form_for @application_setting, url: network_admin_application_settings_path(anchor: 'js-releases-api-limits-settings'), html: { class: 'fieldset-form' } do |f|
      = form_errors(@application_setting)

      %fieldset
        .form-group
          = f.label :release_writes_limit_per_user, _('Maximum release writes per minute per user'), class: 'label-bold'
          = f.number_field :release_writes_limit_per_user, min: 0, class: 'form-control gl-form-input'
          .form-text.gl-text-subtle
            = _('Set to 0 to disable the limit.')
        .form-group
          = f.label :release_writes_limit_per_project, _('Maximum release writes per minute per project'), class: 'label-bold'
          = f.number_field :release_writes_limit_per_project, min: 0, class: 'form-control gl-form-input'
          .form-text.gl-text-subtle
            = _('Set to 0 to disable the limit.')
        .form-group
          = f.label :release_evidence_collections_limit_per_user, _('Maximum release evidence collections per minute per user'), class: 'label-bold'
          = f.number_field :release_evidence_collections_limit_per_user, min: 0, class: 'form-control gl-form-input'
          .form-text.gl-text-subtle
            = _('Set to 0 to disable the limit.')

      = f.submit _('Save changes'), pajamas_button: true
