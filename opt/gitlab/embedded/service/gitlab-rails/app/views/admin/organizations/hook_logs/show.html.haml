- retry_url = retry_organization_admin_settings_hook_hook_log_path(@organization, @hook, @hook_log)
-# rubocop:disable Gitlab/AvoidOrganizationUrlRoutes -- org admin routes have no global equivalent
- add_to_breadcrumbs _('Webhooks'), organization_admin_settings_hooks_path(@organization)
-# rubocop:enable Gitlab/AvoidOrganizationUrlRoutes
- page_title _('Request details')
= render ::Layouts::PageHeadingComponent.new(_('Request details'))

- if can?(current_user, :resend_webhook_event, @organization)
  - if @hook_log.oversize?
    - tooltip = _("Request data is too large")
    = render Pajamas::ButtonComponent.new(disabled: true, button_options: { class: 'gl-float-right gl-ml-3 has-tooltip', title: tooltip }) do
      = _("Resend Request")
  - else
    = render Pajamas::ButtonComponent.new(href: retry_url, method: :post, button_options: { class: 'gl-float-right gl-ml-3' }) do
      = _("Resend Request")

= render partial: 'shared/hook_logs/content', locals: { hook_log: @hook_log }
