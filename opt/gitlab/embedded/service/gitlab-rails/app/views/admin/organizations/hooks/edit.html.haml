-# rubocop:disable Gitlab/AvoidOrganizationUrlRoutes -- org admin routes have no global equivalent
- index_url = organization_admin_settings_hooks_path(@organization)
- form_url = organization_admin_settings_hook_path(@organization, @hook)
-# rubocop:enable Gitlab/AvoidOrganizationUrlRoutes
- add_to_breadcrumbs _('Webhooks'), index_url
- page_title s_('Webhooks|Edit webhook')
- add_page_specific_style 'page_bundles/settings'

= render 'shared/web_hooks/hook_errors', hook: @hook

= render ::Layouts::SettingsSectionComponent.new(page_title) do |c|
  - c.with_description do
    = render 'shared/web_hooks/description', hook: @hook
  - c.with_body do
    = gitlab_ui_form_for @hook, as: :hook, url: form_url, html: { class: 'js-webhook-form' } do |f|
      = render partial: 'shared/web_hooks/form', locals: { form: f, hook: @hook }

      .settings-sticky-footer.gl-flex.gl-justify-between
        .gl-flex.gl-gap-4
          = f.submit _('Save changes'), pajamas_button: true
          = render 'shared/web_hooks/test_button', hook: @hook, organization: @organization
        .gl-flex.gl-gap-4
          = link_button_to _('Close'), index_url
          = link_button_to _('Delete'), form_url, method: :delete, aria: { label: s_('Webhooks|Delete webhook') }, data: { confirm: s_('Webhooks|Are you sure you want to delete this webhook?'), confirm_btn_variant: 'danger' }, variant: :danger

    %hr

    = render partial: 'shared/hook_logs/index', locals: { hook: @hook, hook_logs: @hook_logs, organization: @organization }
