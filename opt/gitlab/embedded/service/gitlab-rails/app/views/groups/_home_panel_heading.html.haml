%span.gl-flex.gl-items-center.gl-gap-3
  = render Pajamas::AvatarComponent.new(group, alt: '', size: 48, class: '!gl-float-none gl-self-start gl-shrink-0', avatar_options: { itemprop: 'logo', aria: { hidden: 'true' } })
  %span.gl-flex.gl-items-center.gl-flex-wrap.gl-gap-3.gl-break-anywhere
    %span{ itemprop: 'name' }= group.name
    %span.visibility-icon.gl-inline-flex.gl-text-subtle.has-tooltip{ data: { container: 'body' }, title: visibility_icon_description(group) }
      = visibility_level_icon(group.visibility_level)
    = render_if_exists 'shared/tier_badge', source: group
    = render 'shared/groups/badges', group: group
