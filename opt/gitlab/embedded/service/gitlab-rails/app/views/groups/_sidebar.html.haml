%aside.group-page-sidebar{ data: { testid: 'group-page-sidebar' } }
  .gl-py-4.gl-border-b.gl-border-b-subtle
    %h2.gl-text-base.gl-font-bold.gl-leading-reset.gl-text-heading.gl-m-0.gl-mb-1= s_('GroupPage|Group information')
    - if group.description.present?
      .home-panel-description.gl-break-words
        .home-panel-description-markdown.read-more-container{ itemprop: 'description', data: { 'read-more-height': 320 } }
          .read-more-content.read-more-content--has-scrim
            = markdown_field(group.namespace_details, :description)
          .js-read-more-trigger.gl-hidden.gl-w-full.gl-h-8.gl-absolute.gl-bottom-0.gl-z-2.gl-bg-default
            = render Pajamas::ButtonComponent.new(variant: :link) do
              = sprite_icon('chevron-down', size: 14)
              = _('Read more')

  - can_read_members = can?(current_user, :read_group_member, group)
  - can_invite_members = can_invite_group_member?(group)
  - if can_read_members || can_invite_members
    .gl-flex.gl-flex-wrap.gl-items-center.gl-gap-3.gl-py-4{ class: '@md/panel:gl-justify-between' }
      - if can_read_members
        = link_to group_group_members_path(group), class: 'gl-flex gl-items-center gl-gap-2 gl-leading-20 gl-text-default hover:gl-text-default', data: { testid: 'group-members-link', event_tracking: 'click_members_link_on_group_overview' } do
          = sprite_icon('user', variant: 'subtle')
          = _('Members')
      - if can_invite_members
        .gl-flex{ data: { event_tracking: 'click_invite_members_on_group_overview' } }
          .js-invite-members-trigger{ data: { variant: 'link', display_text: s_('InviteMember|Invite members'), trigger_source: 'group_overview' } }
