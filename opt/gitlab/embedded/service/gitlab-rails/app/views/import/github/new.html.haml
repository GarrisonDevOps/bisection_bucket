- title = has_ci_cd_only_params? ? _('Authenticate with GitHub') : _('Connect with GitHub')
- page_title title
- header_title _("New project"), new_project_path
- add_to_breadcrumbs s_('ProjectsNew|Import project'), new_project_path(anchor: 'import_project')

= render ::Layouts::PageHeadingComponent.new('') do |c|
  - c.with_heading do
    .gl-flex.gl-gap-3.gl-items-center
      = sprite_icon('github', size: 32)
      = title
  - c.with_description do
    = import_github_authorize_message

- if has_ci_cd_only_params?
  .gl-mt-3
    = render 'personal_access_token_form'
- else
  .gl-rounded-lg.gl-border.gl-bg-subtle.gl-p-6
    - if github_import_configured?
      %h2.gl-heading-2.gl-mt-0= _('Sign in with GitHub')
      %p.gl-text-subtle= s_("GithubImport|You'll sign in on GitHub, grant access, and return here.")
      .gl-mt-5
        = render Pajamas::ButtonComponent.new(variant: :confirm,
          href: status_import_github_path(namespace_id: params[:namespace_id]),
          icon: 'github') do
          = title

      .gl-mt-5
        = render Pajamas::ButtonComponent.new(variant: :link, icon: 'chevron-lg-right',
          button_options: { class: 'js-import-github-pat-toggle', 'aria-expanded': 'false', 'aria-controls': 'personal-access-token-panel',
            data: { testid: 'personal-access-token-toggle' } }) do
          = _('Use a personal access token instead')

      #personal-access-token-panel.gl-hidden.gl-mt-5
        = render 'personal_access_token_form', submit_variant: :default
    - else
      %h2.gl-heading-2.gl-mt-0= s_('GithubImport|Use a personal access token')
      .gl-mt-5
        = render Pajamas::AlertComponent.new(variant: :info, dismissible: false) do |c|
          - c.with_body do
            = import_configure_github_admin_message

      .gl-mt-5
        = render 'personal_access_token_form'
