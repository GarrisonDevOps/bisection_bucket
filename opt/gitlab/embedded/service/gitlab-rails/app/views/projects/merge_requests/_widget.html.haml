%h2#merge-request-widgets-heading.gl-sr-only
  = _("Merge request reports")
#js-vue-mr-widget.mr-widget{
  role: 'region',
  'aria-labelledby': 'merge-request-widgets-heading'
}
  - if Feature.enabled?(:mr_description_after_widget, current_user)
    -# Mirrors loading.vue so the page does not shift when Vue mounts and replaces it.
    .gl-mt-5{ aria: { hidden: 'true' } }
      .mr-section-container.gl-flex.gl-gap-5.gl-p-4
        .gl-animate-skeleton-loader.gl-h-3.gl-rounded-small{ class: 'gl-w-1/6' }
        .gl-animate-skeleton-loader.gl-h-3.gl-rounded-small{ class: 'gl-w-1/2' }
      .mr-section-container.gl-flex.gl-flex-col.gl-gap-3.gl-p-4
        .gl-animate-skeleton-loader.gl-h-3.gl-rounded-small{ class: 'gl-w-1/5' }
        .gl-animate-skeleton-loader.gl-h-3.gl-rounded-small{ class: 'gl-w-1/2' }
        .gl-flex.gl-gap-5
          .gl-animate-skeleton-loader.gl-h-3.gl-rounded-small{ class: 'gl-w-1/12' }
          .gl-animate-skeleton-loader.gl-h-3.gl-rounded-small{ class: 'gl-w-1/6' }
        .gl-animate-skeleton-loader.gl-h-3.gl-rounded-small{ class: 'gl-w-1/12' }
