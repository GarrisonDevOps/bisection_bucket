- if personal_access_token.granular?
  - if personal_access_token.granular_scopes.present?
    .gl-space-y-4
      - personal_access_token.granular_scopes.each do |item|
        %div
          %div
            %span.gl-font-bold= s_('AccessTokens|Permissions:')
            = item.permissions.join(', ')
          %div
            %span.gl-font-bold= s_('AccessTokens|Access:')
            - if item.namespace.present?
              = item.namespace.name
            - else
              %span.gl-capitalize= item.access
  - else
    = _('No Scopes')
- elsif personal_access_token.scopes.present?
  = personal_access_token.scopes.join(', ')
- else
  = _('No Scopes')
