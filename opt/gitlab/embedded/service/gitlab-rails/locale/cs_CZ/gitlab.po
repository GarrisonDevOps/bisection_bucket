msgstr "Zadejte jedinečný název nasazení."

msgid "AdminSelfHostedModels|Please enter an endpoint."
msgstr "Zadejte koncový bod."

msgid "AdminSelfHostedModels|Please select a model."
msgstr "Vyberte model."

msgid "AdminSelfHostedModels|Provide the model identifier in the form of %{identifierLabel}"
msgstr "Zadejte identifikátor modelu ve tvaru %{identifierLabel}"

msgid "AdminSelfHostedModels|Select an appropriate model family from the list of approved GitLab models."
msgstr "Ze seznamu schválených modelů GitLabu vyberte vhodnou rodinu modelů."

msgid "AdminSelfHostedModels|Select model"
msgstr "Vybrat model"

msgid "AdminSelfHostedModels|Self-hosted model was not provided"
msgstr "Nebyl zadán model s vlastním hostováním"

msgid "AdminSelfHostedModels|Self-hosted models"
msgstr "Modely s vlastním hostováním"

msgid "AdminSelfHostedModels|Self-hosted models are available only with the GitLab Duo Enterprise add-on. Contact your administrator."
msgstr "Modely s vlastním hostováním jsou k dispozici jen s doplňkem GitLab Duo Enterprise. Obraťte se na správce."

msgid "AdminSelfHostedModels|Specify the URL endpoint where your self-hosted model is accessible"
msgstr "Zadejte URL koncového bodu, na kterém je váš model s vlastním hostováním dostupný"

msgid "AdminSelfHostedModels|Successfully connected to the self-hosted model"
msgstr "Připojeno k modelu s vlastním hostováním"

msgid "AdminSelfHostedModels|Test connection"
msgstr "Otestovat připojení"

msgid "AdminSelfHostedModels|The provided identifier does not exist. Did you mean %{suggestions}?"
msgstr "Zadaný identifikátor neexistuje. Měli jste na mysli %{suggestions}?"

msgid "AdminSelfHostedModels|The self-hosted model was successfully saved."
msgstr "Model s vlastním hostováním byl uložen."

msgid "AdminSelfHostedModels|There was an error saving the self-hosted model. Please try again."
msgstr "Při ukládání modelu s vlastním hostováním došlo k chybě. Zkuste to znovu."

msgid "AdminSelfHostedModels|This feature is using a GitLab-managed model, external to your infrastructure."
msgstr "Tato funkce používá model spravovaný GitLabem, mimo vaši infrastrukturu."

msgid "AdminSelfHostedModels|This feature is using a self-hosted model, deployed on your own infrastructure."
msgstr "Tato funkce používá model s vlastním hostováním nasazený ve vaší vlastní infrastruktuře."

msgid "AdminSelfHostedModels|This self-hosted model cannot be deleted"
msgstr "Tento model s vlastním hostováním nelze smazat"

msgid "AdminSelfHostedModels|To fully set up AWS credentials for this model please refer to the %{linkStart}AWS Bedrock Configuration Guide%{linkEnd}"
msgstr "Úplné nastavení přihlašovacích údajů AWS pro tento model najdete v %{linkStart}průvodci konfigurací AWS Bedrock%{linkEnd}"

msgid "AdminSelfHostedModels|To fully set up Google Cloud credentials for this model please refer to the %{linkStart}Google Vertex AI Configuration Guide%{linkEnd}"
msgstr "Úplné nastavení přihlašovacích údajů Google Cloud pro tento model najdete v %{linkStart}průvodci konfigurací Google Vertex AI%{linkEnd}"

msgid "AdminSelfHostedModels|To remove %{boldStart}%{modelName}%{boldEnd}, you must first remove it from the following AI Feature(s):"
msgstr "Chcete-li odebrat %{boldStart}%{modelName}%{boldEnd}, musíte ho nejdřív odebrat z těchto funkcí AI:"

msgid "AdminSelfHostedModels|Updated model for %{title}"
msgstr "Model pro %{title} byl aktualizován"

msgid "AdminSelfHostedModels|View AI-native features"
msgstr "Zobrazit funkce s nativní AI"

msgid "AdminSelfHostedModels|You are about to delete the %{boldStart}%{modelName}%{boldEnd} self-hosted model. This action cannot be undone."
msgstr "Chystáte se smazat model s vlastním hostováním %{boldStart}%{modelName}%{boldEnd}. Tuto akci nelze vrátit zpět."

msgid "AdminSelfHostedModels|You have not configured your local AI gateway URL. Configure the URL in the GitLab Duo configuration settings."
msgstr "Nenakonfigurovali jste URL místní AI Gateway. Nakonfigurujte ji v nastavení konfigurace GitLab Duo."

msgid "AdminSelfHostedModels|Your self-hosted model was successfully deleted."
msgstr "Váš model s vlastním hostováním byl smazán."

msgid "AdminSettingsUsageBilling|Display user data"
msgstr "Zobrazovat údaje uživatelů"

msgid "AdminSettingsUsageBilling|GitLab Credits dashboard"
msgstr "Přehled kreditů GitLab"

msgid "AdminSettingsUsageBilling|If selected, individual usernames and their credit usage are visible on the GitLab Credits dashboard. If your organization needs to restrict access to individual user activity for compliance or privacy reasons, clear this checkbox."
msgstr "Pokud je tato možnost vybraná, jsou v přehledu kreditů GitLab vidět jednotlivá uživatelská jména a jejich čerpání kreditů. Pokud vaše organizace z důvodu dodržování předpisů nebo ochrany soukromí potřebuje omezit přístup k aktivitě jednotlivých uživatelů, zrušte zaškrtnutí tohoto políčka."

msgid "AdminSettings|%{generate_manually_link_start}Generate%{generate_manually_link_end} Service Ping to preview and download service usage data payload."
msgstr "%{generate_manually_link_start}Vygenerujte%{generate_manually_link_end} Service Ping, abyste mohli zobrazit náhled datové části s údaji o využití služby a stáhnout ji."

msgid "AdminSettings|%{setting_name} value used by both Rails and Browser JavaScript SDKs."
msgstr "Hodnota %{setting_name}, kterou používají sady SDK pro Rails i pro JavaScript v prohlížeči."

msgid "AdminSettings|%{setting_name} value used by the Browser JavaScript SDK."
msgstr "Hodnota %{setting_name}, kterou používá sada SDK pro JavaScript v prohlížeči."

msgid "AdminSettings|%{setting_name} value used by the Rails SDK."
msgstr "Hodnota %{setting_name}, kterou používá sada SDK pro Rails."

msgid "AdminSettings|%{strongStart}WARNING:%{strongEnd} Environment variable %{environment_variable} does not exist or is not pointing to a valid directory. %{icon_link}"
msgstr "%{strongStart}VAROVÁNÍ:%{strongEnd} Proměnná prostředí %{environment_variable} neexistuje nebo neukazuje na platný adresář. %{icon_link}"

msgid "AdminSettings|A Let's Encrypt account will be configured for this GitLab instance using this email address. You will receive emails to warn of expiring certificates. %{link_start}Learn more%{link_end}."
msgstr "Pro tuto instanci GitLab se s touto e-mailovou adresou nakonfiguruje účet Let's Encrypt. Budou vám na ni chodit upozornění na končící certifikáty. %{link_start}Další informace%{link_end}."

msgid "AdminSettings|Active session history"
msgstr "Historie aktivních relací"

msgid "AdminSettings|Add a custom message with details about instance runners. The message is visible when you view runners for projects and groups. Markdown is supported."
msgstr "Přidejte vlastní zprávu s podrobnostmi o runnerech instance. Zpráva se zobrazí při prohlížení runnerů projektů a skupin. Podporuje se Markdown."

msgid "AdminSettings|Affects all new and existing groups."
msgstr "Ovlivňuje všechny nové a existující skupiny."

msgid "AdminSettings|After upgrading, only the standard field names will be emitted. Enable dual-emit first if you need a transition period."
msgstr "Po upgradu se budou zapisovat jen standardní názvy polí. Pokud potřebujete přechodné období, nejdřív zapněte duální zápis (dual-emit)."

msgid "AdminSettings|All new projects can use instance runners by default."
msgstr "Všechny nové projekty mohou ve výchozím stavu používat runnery instance."

msgid "AdminSettings|Allow Google Cloud Application Default Credentials for offline transfer %{link_start}%{icon}%{link_end}"
msgstr "Povolit pro přenos offline výchozí přihlašovací údaje aplikací Google Cloud (Application Default Credentials) %{link_start}%{icon}%{link_end}"

msgid "AdminSettings|Allow S3 compatible object storage for offline transfer"
msgstr "Povolit pro přenos offline objektové úložiště kompatibilní s S3"

msgid "AdminSettings|Allow all integrations"
msgstr "Povolit všechny integrace"

msgid "AdminSettings|Allow connection to GitLab"
msgstr "Povolit připojení ke GitLabu"

msgid "AdminSettings|Allow contribution mapping to administrators %{allow_contribution_mapping_to_admins_link_start}%{icon}%{allow_contribution_mapping_to_admins_link_end}"
msgstr "Povolit mapování příspěvků na správce %{allow_contribution_mapping_to_admins_link_start}%{icon}%{allow_contribution_mapping_to_admins_link_end}"

msgid "AdminSettings|Allow dynamic client registration"
msgstr "Povolit dynamickou registraci klientů"

msgid "AdminSettings|Allow exporting GitLab groups and projects by offline transfer"
msgstr "Povolit export skupin a projektů GitLab přenosem offline"

msgid "AdminSettings|Allow importing GitLab groups and projects by offline transfer"
msgstr "Povolit import skupin a projektů GitLab přenosem offline"

msgid "AdminSettings|Allow migrating GitLab groups and projects by direct transfer"
msgstr "Povolit migraci skupin a projektů GitLab přímým přenosem"

msgid "AdminSettings|Allow only integrations on this allowlist"
msgstr "Povolit jen integrace ze seznamu povolených"

msgid "AdminSettings|Allow runner registration token"
msgstr "Povolit registrační token runneru"

msgid "AdminSettings|Allow users to make their profiles private"
msgstr "Povolit uživatelům nastavit profil jako soukromý"

msgid "AdminSettings|Also emitted as (deprecated)"
msgstr "Zapisuje se také jako (označeno jako zastaralé)"

msgid "AdminSettings|Applies to new projects. Existing projects are not affected."
msgstr "Platí pro nové projekty. Stávajících projektů se to netýká."

msgid "AdminSettings|Apply the Free plan Service Desk email rate limits to a top-level namespace for a number of days after it moves to a paid plan."
msgstr ""

msgid "AdminSettings|Are you sure you want to revert to the default extension host domain?"
msgstr "Opravdu se chcete vrátit k výchozí doméně hostitele rozšíření?"

msgid "AdminSettings|Audit events API rate limits"
msgstr "Limity četnosti API událostí auditu"

