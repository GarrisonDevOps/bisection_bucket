msgstr "Zobrazovat banner migrace z Jenkinsu"

msgid "AdminSettings|Silent exports by admins %{silent_admin_exports_link_start}%{icon}%{silent_admin_exports_link_end}"
msgstr "Tichý export prováděný správci %{silent_admin_exports_link_start}%{icon}%{silent_admin_exports_link_end}"

msgid "AdminSettings|Size and domain settings for Pages static sites."
msgstr "Nastavení velikosti a domén pro statické weby Pages."

msgid "AdminSettings|Skip confirmation when administrators reassign placeholder users %{link_start}%{icon}%{link_end}"
msgstr "Přeskočit potvrzení, když správci mění přiřazení zástupných uživatelů %{link_start}%{icon}%{link_end}"

msgid "AdminSettings|Standard field name"
msgstr "Standardní název pole"

msgid "AdminSettings|The default domain to use for Auto Review Apps and Auto Deploy stages in all projects."
msgstr "Výchozí doména, která se má použít pro fáze Auto Review Apps a Auto Deploy ve všech projektech."

msgid "AdminSettings|The extension host domain provided is not a valid domain name."
msgstr "Zadaná doména hostitele rozšíření není platný název domény."

msgid "AdminSettings|The latest artifacts for all jobs in the most recent successful pipelines in each project are stored and do not expire."
msgstr "Nejnovější artefakty pro všechny úlohy v nejnovějších úspěšných pipeline v každém projektu jsou uloženy a jejich platnost nevyprší."

msgid "AdminSettings|The maximum number of caches that can be defined in a single CI/CD job. Default is 4. Higher values can impact pipeline creation performance."
msgstr "Maximální počet mezipamětí, které lze definovat v jedné úloze CI/CD. Výchozí hodnota je 4. Vyšší hodnoty mohou zhoršit výkon vytváření pipeline."

msgid "AdminSettings|The maximum number of downstream pipelines that can be triggered per minute (for a given project, user, and commit)."
msgstr "Maximální počet navazujících pipeline, které lze spustit za minutu (pro daný projekt, uživatele a commit)."

msgid "AdminSettings|The maximum number of included files per pipeline."
msgstr "Maximální počet zahrnutých souborů na pipeline."

msgid "AdminSettings|The maximum number of job cancellations allowed per minute for a given project. Set to 0 to disable this limit."
msgstr "Maximální počet zrušení úloh za minutu povolený pro daný projekt. Nastavením na 0 tento limit vypnete."

msgid "AdminSettings|The maximum number of job erasures allowed per minute for a given project. Set to 0 to disable this limit."
msgstr "Maximální počet smazání úloh za minutu povolený pro daný projekt. Nastavením na 0 tento limit vypnete."

msgid "AdminSettings|The maximum number of job retries allowed per minute for a given project. Set to 0 to disable this limit."
msgstr "Maximální počet opakování úloh za minutu povolený pro daný projekt. Nastavením na 0 tento limit vypnete."

msgid "AdminSettings|The maximum number of manual job runs allowed per minute for a given project. Set to 0 to disable this limit."
msgstr "Maximální počet ručních spuštění úloh za minutu pro daný projekt. Nastavením na 0 tento limit vypnete."

msgid "AdminSettings|The maximum number of pipeline cancellations allowed per minute for a given project. Set to 0 to disable this limit."
msgstr "Maximální počet zrušení pipeline za minutu pro daný projekt. Nastavením na 0 tento limit vypnete."

msgid "AdminSettings|The maximum number of pipeline deletions allowed per minute for a given project. Set to 0 to disable this limit."
msgstr "Maximální počet smazání pipeline za minutu pro daný projekt. Nastavením na 0 tento limit vypnete."

msgid "AdminSettings|The maximum number of pipeline retries allowed per minute for a given project. Set to 0 to disable this limit."
msgstr "Maximální počet opakování pipeline za minutu pro daný projekt. Nastavením na 0 tento limit vypnete."

msgid "AdminSettings|The maximum number of runner job list requests filtered by a completed status (success, failed, or canceled) allowed per minute for a given user. Set to 0 to disable this limit."
msgstr ""

msgid "AdminSettings|The maximum number of tag or branch pipelines triggered by a single Git push. Setting the limit to 0 will remove the limit."
msgstr "Maximální počet pipeline pro tagy nebo větve spuštěných jedním Git push. Nastavením na 0 se limit odstraní."

msgid "AdminSettings|The option to make profiles private has been disabled. Profiles are required to be public in this instance, and cannot be set to private by default. %{linkStart}Learn more%{linkEnd}."
msgstr "Možnost nastavit profily jako soukromé je vypnutá. Profily musí být v této instanci veřejné a nelze je ve výchozím nastavení nastavit jako soukromé. %{linkStart}Další informace%{linkEnd}."

msgid "AdminSettings|The selected level must be different from the selected default group and project visibility."
msgstr "Vybraná úroveň se musí lišit od vybrané výchozí viditelnosti skupin a projektů."

msgid "AdminSettings|The template for the required pipeline configuration can be one of the GitLab-provided templates, or a custom template added to an instance template repository. %{link_start}How do I create an instance template repository?%{link_end}"
msgstr "Šablonou pro povinnou konfiguraci pipeline může být některá ze šablon poskytovaných GitLabem nebo vlastní šablona přidaná do repozitáře šablon instance. %{link_start}Jak vytvořit repozitář šablon instance?%{link_end}"

msgid "AdminSettings|There are Advanced Search migrations pending that require indexing to pause. Indexing must remain paused until GitLab completes the migrations."
msgstr ""

msgid "AdminSettings|This cost factor will be applied to the storage consumed by forks."
msgstr "Tento nákladový faktor se použije na úložiště spotřebované forky."

msgid "AdminSettings|This limit cannot be disabled. Set to 0 to block all job (needs) dependencies."
msgstr "Tento limit nelze vypnout. Nastavením na 0 zablokujete všechny závislosti úloh (needs)."

msgid "AdminSettings|This setting is currently controlled by the %{env_var} environment variable and cannot be changed through the UI. Current value: %{value}"
msgstr "Toto nastavení je aktuálně řízeno proměnnou prostředí %{env_var} a nelze ho změnit v uživatelském rozhraní. Aktuální hodnota: %{value}"

msgid "AdminSettings|To enable Registration Features, first enable Service Ping."
msgstr "Chcete-li zapnout funkce registrace, nejprve zapněte Service Ping."

msgid "AdminSettings|To enable Registration Features, first enable optional data in Service Ping."
msgstr "Chcete-li zapnout funkce registrace, nejprve zapněte v Service Ping volitelná data."

