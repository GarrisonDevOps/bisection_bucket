msgstr "Limity CI/CD"

msgid "AdminSettings|Code can be imported from enabled sources during project creation. OmniAuth must be configured for GitHub %{github_docs_link_start}%{icon}%{github_docs_link_end} and Bitbucket %{bitbucket_docs_link_start}%{icon}%{bitbucket_docs_link_end}."
msgstr "Při vytváření projektu lze importovat kód ze zapnutých zdrojů. Pro GitHub %{github_docs_link_start}%{icon}%{github_docs_link_end} a Bitbucket %{bitbucket_docs_link_start}%{icon}%{bitbucket_docs_link_end} musí být nakonfigurovaný OmniAuth."

msgid "AdminSettings|Code search with advanced search"
msgstr "Vyhledávání v kódu pomocí rozšířeného vyhledávání"

msgid "AdminSettings|Configure Let's Encrypt"
msgstr "Konfigurovat Let's Encrypt"

msgid "AdminSettings|Configure limits on the number of repositories users can download, clone, or fork in a given time."
msgstr "Nakonfigurujte limity počtu repozitářů, které mohou uživatelé za určitou dobu stáhnout, naklonovat nebo forknout."

msgid "AdminSettings|Configure the Web IDE extension host domain."
msgstr "Nakonfigurujte doménu hostitele rozšíření pro Web IDE."

msgid "AdminSettings|Configure when dormant projects should be automatically deleted. %{linkStart}What are dormant projects?%{linkEnd}"
msgstr "Nakonfigurujte, kdy se mají neaktivní projekty automaticky mazat. %{linkStart}Co jsou neaktivní projekty?%{linkEnd}"

msgid "AdminSettings|Control the version of the logging field naming"
msgstr "Určit verzi pojmenování polí v logu"

msgid "AdminSettings|Control whether built-in project templates are available for new projects. You can enforce this setting for all groups."
msgstr "Určete, zda jsou pro nové projekty k dispozici vestavěné šablony projektů. Toto nastavení můžete vynutit pro všechny skupiny."

msgid "AdminSettings|Control which projects can publish components to the CI/CD Catalog. Enter one project path or regular expression pattern per line. For example: %{code_start}gitlab-org/my-project%{code_end}, %{code_start}gitlab-org/.*%{code_end}, or %{code_start}gitlab-org/security-.*%{code_end}. If empty, any project can publish."
msgstr "Určete, které projekty mohou publikovat komponenty v CI/CD Catalogu. Na každý řádek zadejte jednu cestu projektu nebo vzor regulárního výrazu. Například: %{code_start}gitlab-org/my-project%{code_end}, %{code_start}gitlab-org/.*%{code_end} nebo %{code_start}gitlab-org/security-.*%{code_end}. Pokud je pole prázdné, může publikovat jakýkoli projekt."

msgid "AdminSettings|Could not update extension host domain"
msgstr "Doménu hostitele rozšíření se nepodařilo aktualizovat"

msgid "AdminSettings|Current version"
msgstr "Aktuální verze"

msgid "AdminSettings|Days with Free plan limits"
msgstr ""

msgid "AdminSettings|Default expiration time for parallel deployments (in seconds)"
msgstr "Výchozí doba vypršení paralelních nasazení (v sekundách)"

msgid "AdminSettings|Delete dormant projects"
msgstr "Mazat neaktivní projekty"

msgid "AdminSettings|Delete dormant projects that exceed"
msgstr "Mazat neaktivní projekty, které překročí"

msgid "AdminSettings|Delete project after"
msgstr "Smazat projekt po"

msgid "AdminSettings|Disable feed token"
msgstr "Vypnout token kanálu"

msgid "AdminSettings|Disable public access to Pages sites"
msgstr "Vypnout veřejný přístup k webům Pages"

msgid "AdminSettings|Domain verification is an essential security measure for public GitLab sites. Users are required to demonstrate they control a domain before it is enabled. %{link_start}Learn more%{link_end}."
msgstr "Ověření domény je pro veřejné weby GitLab zásadní bezpečnostní opatření. Uživatelé musí prokázat, že doménu ovládají, než se zapne. %{link_start}Další informace%{link_end}."

msgid "AdminSettings|Dormant project deletion"
msgstr "Mazání neaktivních projektů"

msgid "AdminSettings|Download payload"
msgstr "Stáhnout datovou část"

msgid "AdminSettings|Dual-emit target version"
msgstr "Cílová verze duálního zápisu"

msgid "AdminSettings|During dual-emit, both the standard and deprecated field names appear in every log line. Disable dual-emit to stop emitting deprecated names."
msgstr "Při duálním zápisu se v každém řádku logu objevují standardní i zastaralé názvy polí. Chcete-li zastaralé názvy přestat zapisovat, duální zápis vypněte."

msgid "AdminSettings|Emit this version alongside the schema version. Must be strictly greater than the schema version."
msgstr "Zapisovat tuto verzi spolu s verzí schématu. Musí být ostře větší než verze schématu."

msgid "AdminSettings|Enable \"Delete source branch\" option by default"
msgstr "Ve výchozím nastavení zapnout volbu „Smazat zdrojovou větev“"

msgid "AdminSettings|Enable Registration Features"
msgstr "Zapnout funkce registrace"

msgid "AdminSettings|Enable Sentry for Rails and Browser JavaScript"
msgstr "Zapnout Sentry pro Rails a JavaScript v prohlížeči"

msgid "AdminSettings|Enable Service Ping Generation"
msgstr "Zapnout generování Service Ping"

msgid "AdminSettings|Enable Service Ping. When disabled, Service Ping data will not be automatically sent"
msgstr "Zapnout Service Ping. Když je vypnutý, data Service Ping se nebudou automaticky odesílat"

msgid "AdminSettings|Enable authenticated MCP server request rate limit"
msgstr "Zapnout limit četnosti ověřených žádostí na server MCP"

msgid "AdminSettings|Enable automatic generation of Service Ping data. When disabled, Service Ping data will not be automatically generated."
msgstr "Zapnout automatické generování dat Service Ping. Když je vypnuté, data Service Ping se nebudou automaticky generovat."

msgid "AdminSettings|Enable built-in project templates"
msgstr "Zapnout vestavěné šablony projektů"

msgid "AdminSettings|Enable collection of application metrics. Restart required. %{link_start}Learn how to export metrics to Prometheus%{link_end}."
msgstr "Zapnout shromažďování metrik aplikace. Vyžaduje restart. %{link_start}Jak exportovat metriky do systému Prometheus%{link_end}."

msgid "AdminSettings|Enable event tracking"
msgstr "Zapnout sledování událostí"

msgid "AdminSettings|Enable instance runners for new projects"
msgstr "Zapnout runnery instance pro nové projekty"

msgid "AdminSettings|Enable kuromoji custom analyzer: Indexing"
msgstr "Zapnout vlastní analyzátor kuromoji: indexování"

msgid "AdminSettings|Enable kuromoji custom analyzer: Search"
msgstr "Zapnout vlastní analyzátor kuromoji: vyhledávání"

msgid "AdminSettings|Enable single origin fallback"
msgstr "Zapnout záložní režim s jedním původem"

msgid "AdminSettings|Enable smartcn custom analyzer: Indexing"
msgstr "Zapnout vlastní analyzátor smartcn: indexování"

msgid "AdminSettings|Enable smartcn custom analyzer: Search"
msgstr "Zapnout vlastní analyzátor smartcn: vyhledávání"

msgid "AdminSettings|Enable the external redirect warning page for job artifacts"
msgstr "Zapnout u artefaktů úloh stránku s upozorněním na externí přesměrování"

msgid "AdminSettings|Enable unique domains by default"
msgstr "Ve výchozím stavu zapnout unikátní domény"

msgid "AdminSettings|Enable unique domains by default for Pages sites to avoid cookie sharing between sites under a given namespace. %{link_start}Learn more%{link_end}."
msgstr "Ve výchozím stavu zapnout pro weby Pages unikátní domény, aby weby ve stejném jmenném prostoru nesdílely soubory cookie. %{link_start}Další informace%{link_end}."

msgid "AdminSettings|Enabled"
msgstr "Zapnuto"

msgid "AdminSettings|Enabling dual-emit can significantly increase logging costs. Every dual-emitted field is written twice on each request, which roughly doubles log volume for affected fields. Use only as long as needed to validate a schema migration, then disable."
msgstr "Zapnutí duálního zápisu může výrazně zvýšit náklady na logování. Každé takové pole se při každé žádosti zapisuje dvakrát, takže objem logů u dotčených polí se zhruba zdvojnásobí. Používejte ho jen po dobu nutnou k ověření migrace schématu a pak ho vypněte."

msgid "AdminSettings|Enforce PIPL compliance"
msgstr "Vynutit soulad s PIPL"

msgid "AdminSettings|Enforce PIPL compliance for all users"
msgstr "Vynutit soulad s PIPL pro všechny uživatele"

msgid "AdminSettings|Enforce for all groups"
msgstr "Vynutit pro všechny skupiny"

msgid "AdminSettings|Enforce invitation flow for groups and projects"
msgstr "Vynutit pro skupiny a projekty postup přes pozvánky"

msgid "AdminSettings|Enter project IDs separated by commas or newlines."
msgstr "Zadejte ID projektů oddělená čárkami nebo novými řádky."

msgid "AdminSettings|Example: 123, 456 or one project ID per line"
msgstr "Příklad: 123, 456 nebo jedno ID projektu na řádek"

msgid "AdminSettings|Extension host domain"
msgstr "Doména hostitele rozšíření"

msgid "AdminSettings|Feed token"
msgstr "Token kanálu"

msgid "AdminSettings|For a list of included Registration Features, see %{link_start}the documentation%{link_end}."
msgstr "Seznam zahrnutých funkcí registrace najdete v %{link_start}dokumentaci%{link_end}."

msgid "AdminSettings|For more information, see %{link_start}the documentation%{link_end}."
msgstr "Další informace najdete v %{link_start}dokumentaci%{link_end}."

msgid "AdminSettings|Git abuse rate limit"
msgstr "Limit četnosti proti zneužití Gitu"

msgid "AdminSettings|GitLab MCP server rate limits"
msgstr "Limity četnosti serveru GitLab MCP"

msgid "AdminSettings|GitLab prevents namespace reclamation authentication bypass attacks by blocking JWT generation in projects that were moved or renamed to a previously existing project path. Only allow JWT generation for reclaimed project paths if you understand and accept the insider-threat risk. The restriction is enabled by default and should remain enabled on most instances."
msgstr "GitLab brání útokům na obejití ověřování přes opětovné obsazení jmenného prostoru tím, že blokuje generování JWT v projektech, které byly přesunuty nebo přejmenovány na dříve existující cestu projektu. Generování JWT pro znovu použité cesty projektů povolte jen tehdy, pokud rozumíte riziku vnitřní hrozby a přijímáte ho. Omezení je ve výchozím stavu zapnuté a na většině instancí by mělo zůstat zapnuté."

msgid "AdminSettings|GitLab uses the %{bold_start}Rails%{bold_end} and %{bold_start}Browser JavaScript%{bold_end} Sentry SDKs to send events to Sentry. For changes to Rails integration settings to take effect, restart GitLab."
msgstr "GitLab k odesílání událostí do Sentry používá sady SDK Sentry pro %{bold_start}Rails%{bold_end} a %{bold_start}JavaScript v prohlížeči%{bold_end}. Aby se změny nastavení integrace s Rails projevily, restartujte GitLab."

msgid "AdminSettings|Group runners expiration"
msgstr "Vypršení platnosti runnerů skupin"

msgid "AdminSettings|Groups cannot change this setting."
msgstr "Skupiny toto nastavení nemohou změnit."

msgid "AdminSettings|Has no effect until you install pg_ash. Changes to this setting apply automatically, but can take up to 90 seconds."
msgstr "Nemá žádný účinek, dokud nenainstalujete pg_ash. Změny tohoto nastavení se projeví automaticky, ale může to trvat až 90 sekund."

msgid "AdminSettings|How often to take a sample, in seconds. Must be between 1 and 60. Default is 1."
msgstr "Jak často pořizovat vzorek (v sekundách). Musí být mezi 1 a 60. Výchozí hodnota je 1."

msgid "AdminSettings|I have read and agree to the Let's Encrypt %{link_start}Terms of Service%{link_end} (PDF)."
msgstr "Mám přečtené %{link_start}podmínky služby Let's Encrypt%{link_end} (PDF) a souhlasím s nimi."

msgid "AdminSettings|If exact code search is enabled, you should turn off this setting to save resources."
msgstr "Pokud je zapnuté přesné vyhledávání v kódu, měli byste toto nastavení vypnout, abyste ušetřili zdroje."

msgid "AdminSettings|If no unit is written, it defaults to seconds. For example, these are all equivalent: %{oneDayInSeconds}, %{oneDayInHoursHumanReadable}, or %{oneDayHumanReadable}. Minimum value is two hours. %{linkStart}Learn more%{linkEnd}."
msgstr "Pokud nezadáte jednotku, použijí se sekundy. Například tyto zápisy jsou rovnocenné: %{oneDayInSeconds}, %{oneDayInHoursHumanReadable} nebo %{oneDayHumanReadable}. Minimální hodnota jsou dvě hodiny. %{linkStart}Další informace%{linkEnd}."

msgid "AdminSettings|If not specified at the group or instance level, the default is %{default_initial_branch_name}. Does not affect existing repositories."
msgstr "Pokud není nastaveno na úrovni skupiny nebo instance, výchozí hodnota je %{default_initial_branch_name}. Netýká se stávajících repozitářů."

