msgstr "Platnost tokenu úlohy CI vypršela. Úloha možná překročila maximální časový limit."

msgid "Job|The CI/CD is disabled for this project"
msgstr "CI/CD je pro tento projekt vypnuté"

msgid "Job|The Duo Workflow job failed because the runner could not connect to the Duo Agent Platform. Check your network configuration and try again."
msgstr "Úloha Duo Workflow selhala, protože se runner nemohl připojit k Duo Agent Platform. Zkontrolujte konfiguraci sítě a zkuste to znovu."

msgid "Job|The Job Router failed to run this job."
msgstr "Job Routeru se nepodařilo tuto úlohu spustit."

msgid "Job|The artifacts were removed"
msgstr "Artefakty byly odebrány"

msgid "Job|The artifacts will be removed"
msgstr "Artefakty budou odebrány"

msgid "Job|The canceling job exceeded the maximum execution time set for the job"
msgstr "Rušená úloha překročila maximální dobu běhu nastavenou pro úlohu"

msgid "Job|The deployment job is older than the latest deployment, and therefore failed."
msgstr "Úloha nasazení je starší než poslední nasazení, a proto selhala."

msgid "Job|The deployment job is older than the previously succeeded deployment job, and therefore cannot be run"
msgstr "Úloha nasazení je starší než předchozí úspěšná úloha nasazení, a proto ji nelze spustit"

msgid "Job|The downstream pipeline could not be created"
msgstr "Navazující pipeline se nepodařilo vytvořit"

msgid "Job|The downstream pipeline tree is too large"
msgstr "Strom navazujících pipeline je příliš velký"

msgid "Job|The environment this job is deploying to is protected. Only users with permission may successfully run this job."
msgstr "Prostředí, do kterého tato úloha nasazuje, je chráněné. Úspěšně ji mohou spustit jen uživatelé s oprávněním."

msgid "Job|The job belongs to a deleted project"
msgstr "Úloha patří ke smazanému projektu"

msgid "Job|The job failed to complete prerequisite tasks"
msgstr "Úloze se nepodařilo dokončit přípravné kroky"

msgid "Job|The job is archived and cannot be run"
msgstr "Úloha je archivovaná a nelze ji spustit"

msgid "Job|The job log size limit was reached"
msgstr "Byl dosažen limit velikosti logu úlohy"

msgid "Job|The job was canceling but showed no activity for an extended period. Try again"
msgstr "Úloha se rušila, ale delší dobu nevykazovala žádnou aktivitu. Zkuste to znovu"

msgid "Job|The job was running but showed no activity for an extended period. Check your job script or try again"
msgstr "Úloha běžela, ale delší dobu nevykazovala žádnou aktivitu. Zkontrolujte skript úlohy nebo to zkuste znovu"

msgid "Job|The job was stuck in pending state with matching runners available. Check your job configuration or try again"
msgstr "Úloha nereagovala ve stavu Čeká, přestože byly k dispozici odpovídající runnery. Zkontrolujte konfiguraci úlohy nebo to zkuste znovu"

msgid "Job|The job was stuck in pending state with no matching runners available. Check your runner tags or configuration"
msgstr "Úloha nereagovala ve stavu Čeká a nebyly k dispozici žádné odpovídající runnery. Zkontrolujte tagy nebo konfiguraci runneru"

msgid "Job|The runner could not reach an external dependency. Please try again."
msgstr "Runner se nemohl spojit s externí závislostí. Zkuste to znovu."

msgid "Job|The runner process was interrupted before this job could finish. The job is safe to retry."
msgstr "Proces runneru byl přerušen dřív, než mohla tato úloha skončit. Úlohu lze bezpečně opakovat."

msgid "Job|The running job exceeded the maximum execution time set for the job"
msgstr "Běžící úloha překročila maximální dobu běhu nastavenou pro úlohu"

msgid "Job|The scheduler failed to assign job to the runner, please try again or contact system administrator"
msgstr "Plánovači se nepodařilo přiřadit úlohu runneru. Zkuste to znovu nebo se obraťte na správce systému"

msgid "Job|The script exceeded the maximum execution time set for the job"
msgstr "Skript překročil maximální dobu běhu nastavenou pro úlohu"

msgid "Job|The secrets provider can not be found. Check your CI/CD variables and try again."
msgstr "Secrets provider nelze najít. Zkontrolujte proměnné CI/CD a zkuste to znovu."

msgid "Job|The suspended environment is no longer available. It may have expired."
msgstr ""

msgid "Job|The user who created this job is blocked"
msgstr "Uživatel, který tuto úlohu vytvořil, je zablokovaný"

msgid "Job|There has been a configuration error. Check your job configuration or contact your runner administrator."
msgstr "Došlo k chybě konfigurace. Zkontrolujte konfiguraci úlohy nebo se obraťte na správce runneru."

msgid "Job|There has been a missing dependency failure"
msgstr "Došlo k selhání kvůli chybějící závislosti"

msgid "Job|There has been a runner system failure, please try again"
msgstr "Došlo k systémovému selhání runneru. Zkuste to znovu"

msgid "Job|There has been a timeout failure or the job got stuck. Check your timeout limits or try again"
msgstr "Došlo k selhání kvůli vypršení časového limitu nebo úloha přestala reagovat. Zkontrolujte časové limity nebo to zkuste znovu"

msgid "Job|There has been an API failure, please try again"
msgstr "Došlo k selhání API. Zkuste to znovu"

msgid "Job|There has been an unknown job problem, please contact your system administrator with the job ID to review the logs"
msgstr "Došlo k neznámému problému s úlohou. Pro kontrolu logů se obraťte na správce systému a uveďte ID úlohy"

msgid "Job|There is an unknown failure, please try again"
msgstr "Došlo k neznámému selhání. Zkuste to znovu"

msgid "Job|There was a problem retrying the failed job."
msgstr "Při opakování neúspěšné úlohy došlo k chybě."

msgid "Job|These artifacts are the latest. They will not be deleted (even if expired) until newer artifacts are available."
msgstr "Toto jsou nejnovější artefakty. Nebudou smazány (ani po vypršení platnosti), dokud nebudou k dispozici novější."

msgid "Job|This artifact contains SAST scan results in JSON format."
msgstr "Tento artefakt obsahuje výsledky skenu SAST ve formátu JSON."

msgid "Job|This deployment job was rejected."
msgstr "Tato úloha nasazení byla zamítnuta."

msgid "Job|This job belongs to a child pipeline and cannot create further child pipelines"
msgstr "Tato úloha patří k podřízené pipeline a nemůže vytvářet další podřízené pipeline"

msgid "Job|This job cannot be retried."
msgstr ""

msgid "Job|This job could not be executed because downstream bridge project could not be found"
msgstr "Tuto úlohu nebylo možné spustit, protože se nepodařilo najít projekt navazující pipeline (bridge)"

msgid "Job|This job could not be executed because downstream pipeline trigger definition is invalid"
msgstr "Tuto úlohu nebylo možné spustit, protože definice spouštěče navazující pipeline je neplatná"

msgid "Job|This job could not be executed because group IP address restrictions are enabled, and the runner's IP address is not in the allowed range."
msgstr "Tuto úlohu nebylo možné spustit, protože jsou zapnutá omezení IP adres skupiny a IP adresa runneru není v povoleném rozsahu."

msgid "Job|This job could not be executed because it would create an environment with an invalid parameter."
msgstr "Tuto úlohu nebylo možné spustit, protože by vytvořila prostředí s neplatným parametrem."

msgid "Job|This job could not be executed because it would create infinitely looping pipelines"
msgstr "Tuto úlohu nebylo možné spustit, protože by vytvořila nekonečný cyklus pipeline"

msgid "Job|This job could not be executed because its rules could not be evaluated. Check the rules keyword in the CI/CD configuration for this job."
msgstr ""

msgid "Job|This job could not be executed because of insufficient permissions to create a downstream pipeline"
msgstr "Tuto úlohu nebylo možné spustit kvůli nedostatečným oprávněním k vytvoření navazující pipeline"

msgid "Job|This job could not be executed because of insufficient permissions to track the upstream project."
msgstr "Tuto úlohu nebylo možné spustit kvůli nedostatečným oprávněním ke sledování nadřazeného projektu (upstream)."

msgid "Job|This job could not be executed because the pipeline variables file is missing from storage. Run a new pipeline."
msgstr "Tuto úlohu nebylo možné spustit, protože v úložišti chybí soubor s proměnnými pipeline. Spusťte novou pipeline."

msgid "Job|This job could not be executed because the trigger:project value resolved to a blank value. Check that the variables or inputs used in trigger:project are set."
msgstr "Tuto úlohu nebylo možné spustit, protože se hodnota trigger:project vyhodnotila jako prázdná. Zkontrolujte, že jsou nastavené proměnné nebo vstupy použité v trigger:project."

msgid "Job|This job could not be executed because upstream bridge project could not be found."
msgstr "Tuto úlohu nebylo možné spustit, protože se nepodařilo najít projekt nadřazené pipeline (bridge)."

msgid "Job|This job failed because the necessary resources were not successfully created."
msgstr "Tato úloha selhala, protože se nepodařilo vytvořit potřebné prostředky."

msgid "Job|This job failed to retrieve secrets because a secret source group is not the project group or one of its parent groups."
msgstr ""

msgid "Job|This job failed to retrieve secrets because it does not have access to GitLab Secrets Manager."
msgstr "Tato úloha nemohla načíst tajné údaje, protože nemá přístup ke GitLab Secrets Manageru."

msgid "Job|This job is archived"
msgstr "Tato úloha je archivovaná"

msgid "Job|This job is stuck because no runner can pick it up. A runner must be online and not paused. %{linkStart}Protected runners%{linkEnd} only pick up jobs for protected branches and tags. The runner must also have all of the job's tags:"
msgstr ""

msgid "Job|This job is stuck because the project doesn't have any runners online assigned to it."
msgstr "Tato úloha nereaguje, protože projekt nemá přiřazené žádné runnery, které jsou online."

msgid "Job|This job is stuck because you don't have any active runners that can run this job."
msgstr "Tato úloha nereaguje, protože nemáte žádné aktivní runnery, které by ji mohly spustit."

msgid "Job|This job was added by a pipeline execution policy"
msgstr "Tuto úlohu přidala zásada spouštění pipeline"

msgid "Job|This job was added by a scan execution policy"
msgstr "Tuto úlohu přidala zásada spouštění skenů"

msgid "Job|Too many downstream pipelines triggered in the last minute. Try again later."
msgstr "Za poslední minutu bylo spuštěno příliš mnoho navazujících pipeline. Zkuste to později."

msgid "Job|Trigger"
msgstr "Spouštěč"

msgid "Job|View raw"
msgstr "Zobrazit nezpracovaný log"

msgid "Job|Waiting for resource"
msgstr "Čeká na prostředek"

