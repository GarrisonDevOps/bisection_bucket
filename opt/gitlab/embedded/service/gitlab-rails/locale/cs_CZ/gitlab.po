msgstr "Vestavěné šablony projektů"

msgid "AdminSettings|By default, set a limit to 0 to have no limit."
msgstr "Nastavením limitu na 0 limit zrušíte (výchozí stav)."

msgid "AdminSettings|CI/CD Catalog publishing allowlist"
msgstr "Seznam povolených pro publikování v CI/CD Catalogu"

