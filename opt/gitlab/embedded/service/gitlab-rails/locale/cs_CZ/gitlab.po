msgstr "Další modely jsou k dispozici ve verzi beta. Můžete %{linkStart}zapnout funkce beta pro modely s vlastním hostováním%{linkEnd}."

msgid "AdminSelfHostedModels|Name"
msgstr "Název"

msgid "AdminSelfHostedModels|No self-hosted models yet. %{newModelLinkStart}Add a self-hosted model%{newModelLinkEnd} and select it for a feature to start using it."
msgstr "Zatím nejsou žádné modely s vlastním hostováním. %{newModelLinkStart}Přidejte model s vlastním hostováním%{newModelLinkEnd} a vyberte ho pro některou funkci, abyste ho mohli začít používat."

msgid "AdminSelfHostedModels|Once the model is no longer in use, you can return here to delete it."
msgstr "Až se model přestane používat, můžete se sem vrátit a smazat ho."

msgid "AdminSelfHostedModels|Optional. Enter the ARN of an IAM role the AI Gateway assumes through AWS Security Token Service (STS) %{codeStart}AssumeRole%{codeEnd} to call Amazon Bedrock. The role's trust policy must require your GitLab instance ID, %{instanceId}, as %{codeStart}sts:ExternalId%{codeEnd}. %{linkStart}How do I configure LLM platforms%{linkEnd}?"
msgstr "Volitelné. Zadejte ARN role IAM, kterou AI Gateway převezme přes AWS Security Token Service (STS) %{codeStart}AssumeRole%{codeEnd}, aby mohla volat Amazon Bedrock. Zásady důvěryhodnosti role musí vyžadovat ID vaší instance GitLab, %{instanceId}, jako %{codeStart}sts:ExternalId%{codeEnd}. %{linkStart}Jak nakonfigurovat platformy LLM%{linkEnd}?"

msgid "AdminSelfHostedModels|Platform"
msgstr "Platforma"

msgid "AdminSelfHostedModels|Please add a valid endpoint."
msgstr "Zadejte platný koncový bod."

msgid "AdminSelfHostedModels|Please enter a deployment name."
msgstr "Zadejte název nasazení."

msgid "AdminSelfHostedModels|Please enter a model identifier."
msgstr "Zadejte identifikátor modelu."

