msgstr "Ketika dipilih, sinkron grup hanya akan terjadi ketika kedua nama dan penyedia grup SAML cocok."

msgid "GroupSAML|With %{ra_link_start}restricted access%{ra_link_end} active and no seats available, new users provisioned through SAML/SCIM group sync are assigned the non-billable Minimal Access role. Learn more about %{ra_learn_more_start}provisioning behavior with SAML/SCIM%{ra_learn_more_end}."
msgstr "Dengan %{ra_link_start}akses terbatas%{ra_link_end} aktif dan tidak ada kursi tersedia, pengguna baru disediakan melalui sinkron grup SAML/SCIM ditugaskan peran Akses Minimal tidak dapat ditagih. Pelajari lebih lanjut tentang %{ra_learn_more_start}perilaku penyediaan dengan SAML/SCIM%{ra_learn_more_end}."

msgid "GroupSAML|as %{access_level}"
msgstr "sebagai %{access_level}"

msgid "GroupSAML|must match stored NameID of \"%{extern_uid}\" to identify user and allow sign in"
msgstr "harus cocok NameID dari \"%{extern_uid}\" disimpan untuk mengidentifikasikan pengguna dan mengizinkan masuk"

msgid "GroupSAML|recommend persistent ID instead of email"
msgstr "rekomendasikan ID persisten dan bukan surel"

msgid "GroupSAML|with GitLab Duo seat assignment"
msgstr "dengan penugasan kursi GitLab Duo"

msgid "GroupSaml|Copy SCIM API endpoint URL"
msgstr "Salin URL titik akhir API SCIM"

msgid "GroupSaml|Copy SCIM token"
msgstr "Salin token SCIM"

msgid "GroupSaml|SCIM API endpoint URL"
msgstr "URL titik akhir API SCIM"

