msgstr "https://example.com/openapi.json"

msgid "DastProfiles|https://example.com/postman_collection.json"
msgstr "https://example.com/postman_collection.json"

msgid "DastSiteValidation|Copy HTTP header to clipboard"
msgstr "Salin header HTTP ke papan klip"

msgid "DastSiteValidation|Copy Meta tag to clipboard"
msgstr "Salin tag Meta ke papan klip"

msgid "DastSiteValidation|Could not create validation token. Please try again."
msgstr "Tidak dapat membuat token validasi. Silakan coba lagi."

msgid "DastSiteValidation|Could not revoke validation. Please try again."
msgstr "Tidak dapat mencabut validasi. Silakan coba lagi."

msgid "DastSiteValidation|Download validation text file"
msgstr "Unduh berkas teks validasi"

msgid "DastSiteValidation|Header validation"
msgstr "Validasi header"

msgid "DastSiteValidation|Meta tag validation"
msgstr "Validasi tag meta"

msgid "DastSiteValidation|Not validated"
msgstr "Tidak divalidasi"

msgid "DastSiteValidation|Retry validation"
msgstr "Ulangi validasi"

msgid "DastSiteValidation|Revoke validation"
msgstr "Cabut validasi"

msgid "DastSiteValidation|Step 1 - Choose site validation method."
msgstr "Langkah 1 - Pilih metode validasi situs."

msgid "DastSiteValidation|Step 2 - Add the following HTTP header to your site."
msgstr "Langkah 2 - Tambahkan header HTTP berikut ke situs Anda."

msgid "DastSiteValidation|Step 2 - Add the following meta tag to your site."
msgstr "Langkah 2 - Tambahkan tag meta berikut ke situs Anda."

msgid "DastSiteValidation|Step 2 - Download the following text file, then upload it to the target site."
msgstr "Langkah 2 - Unduh berkas teks berikut, kemudian unggah itu ke situs target."

msgid "DastSiteValidation|Step 3 - Confirm header location."
msgstr "Langkah 3 - Konfirmasikan lokasi header."

msgid "DastSiteValidation|Step 3 - Confirm meta tag location."
msgstr "Langkah 3 - Konfirmasikan lokasi tag meta."

msgid "DastSiteValidation|Step 3 - Confirm text file location."
msgstr "Langkah 3 - Konfirmasikan lokasi berkas teks."

msgid "DastSiteValidation|Text file validation"
msgstr "Validasi berkas teks"

msgid "DastSiteValidation|The validation has failed. Please try again."
msgstr "Validasi telah gagal. Silakan coba lagi."

msgid "DastSiteValidation|The validation is in progress. Please wait…"
msgstr "Validasi sedang berlangsung. Silakan tunggu…"

msgid "DastSiteValidation|This will affect %d other profile targeting the same URL."
msgid_plural "DastSiteValidation|This will affect %d other profiles targeting the same URL."
msgstr[0] "Ini akan mempengaruhi %d profil lain menargetkan URL sama."

msgid "DastSiteValidation|To run an active scan, validate your site. Site profile validation reduces the risk of running an active scan against the wrong website. All site profiles that share the same base URL share the same validation status."
msgstr "Untuk menjalankan pemindaian aktif, validasikan situs Anda. Validasi profil situs mengurangi risiko menjalankan pemindaian aktif terhadap situs web salah. Semua profil situs yang membagikan URL dasar sama membagikan status validasi sama."

msgid "DastSiteValidation|Validate"
msgstr "Validasikan"

msgid "DastSiteValidation|Validate site"
msgstr "Validasikan situs"

msgid "DastSiteValidation|Validated"
msgstr "Divalidasi"

msgid "DastSiteValidation|Validating…"
msgstr "Memvalidasikan…"

msgid "DastSiteValidation|Validation failed"
msgstr "Validasi gagal"

msgid "DastSiteValidation|Validation failed for %{url}. %{retryButtonStart}Retry validation%{retryButtonEnd}."
msgstr "Validasi gagal untuk %{url}. %{retryButtonStart}Ulangi validasi%{retryButtonEnd}."

msgid "DastSiteValidation|Validation succeeded. Both active and passive scans can be run against the target site."
msgstr "Validasi berhasil. Kedua pemindaian aktif dan pasif dapat dijalankan terhadap situs target."

msgid "DastSiteValidation|You will not be able to run active scans against %{url}."
msgstr "Anda tidak akan dapat menjalankan pemindaian aktif terhadap %{url}."

msgid "Data Analyst"
msgstr "Data Analyst"

