msgid "Database '%{database_name}' is using PostgreSQL %{pg_version_current}, but this version of GitLab requires PostgreSQL %{pg_version_minimum}. Please upgrade your environment to a supported PostgreSQL version. See %{pg_requirements_url} for details."
msgstr "Basis data '%{database_name}' menggunakan PostgreSQL %{pg_version_current}, tetapi versi GitLab ini memerlukan PostgreSQL %{pg_version_minimum}. Silakan tingkatkan lingkungan Anda ke versi PostgreSQL didukung. Lihat %{pg_requirements_url} untuk rincian."

msgid "Database Diagnostics"
msgstr "Database Diagnostics"

msgid "Database diagnostics"
msgstr "Diagnostik basis data"

msgid "Database pre-upgrade checks"
msgstr ""

msgid "Database update failed"
msgstr "Pembaruan basis data gagal"

msgid "DatabaseDiagnostics|%{count} large table has no planner statistics, so PostgreSQL can choose bad query plans for it. Run ANALYZE on it in a session with statement_timeout set to 0. ANALYZE on a partitioned table covers its partitions as well and can take a long time."
msgid_plural "DatabaseDiagnostics|%{count} large tables have no planner statistics, so PostgreSQL can choose bad query plans for them. Run ANALYZE on each in a session with statement_timeout set to 0. ANALYZE on a partitioned table covers its partitions as well and can take a long time."
msgstr[0] "%{count} tabel besar tidak memiliki statistik perencana, jadi PostgreSQL dapat memilih rencana kueri buruk untuk mereka. Jalankan ANALYZE pada setiap dalam sesi dengan statement_timeout diatur ke 0. ANALYZE pada tabel berpartisi mencakup partisinya juga dan dapat memakan waktu lama."

msgid "DatabaseDiagnostics|%{count} partitioned table was last analyzed more than twice its expected interval ago. Autovacuum never analyzes a partitioned table, so run ANALYZE on it in a session with statement_timeout set to 0. ANALYZE also samples every partition and can take a long time."
msgid_plural "DatabaseDiagnostics|%{count} partitioned tables were last analyzed more than twice their expected interval ago. Autovacuum never analyzes a partitioned table, so run ANALYZE on each in a session with statement_timeout set to 0. ANALYZE also samples every partition and can take a long time."
msgstr[0] "%{count} tabel berpartisi telah terakhir dianalisis lebih dari dua kali interval diharapkan mereka yang lalu. Vakum otomatis tidak pernah menganalisis tabel berpartisi, jadi jalankan ANALYZE pada setiap dalam sesi dengan statement_timeout diatur ke 0. ANALYZE juga menyampelkan setiap partisi dan dapat memakan waktu lama."

msgid "DatabaseDiagnostics|%{duration} ago"
msgstr ""

msgid "DatabaseDiagnostics|%{milliseconds} ms"
msgstr "%{milliseconds} md"

msgid "DatabaseDiagnostics|%{source} (%{location})"
msgstr "%{source} (%{location})"

msgid "DatabaseDiagnostics|%{value} (effective: %{effective})"
msgstr "%{value} (efektif: %{effective})"

msgid "DatabaseDiagnostics|A cost delay of zero disables throttling, so autovacuum runs at full speed and can cause write storms and replication lag."
msgstr "Penundaan biaya nol menonaktifkan kecepatan, sehingga vakum otomatis berjalan dengan kecepatan penuh dan dapat menyebabkan write storm dan penundaan replikasi."

msgid "DatabaseDiagnostics|A time range can be up to 24 hours long, and start up to 30 days ago."
msgstr "Rentang waktu dapat lebih panjang hingga 24 jam, dan dimulai hingga 30 hari yang lalu."

msgid "DatabaseDiagnostics|A time range shorter than 61 minutes is read as the 61 minutes before its end, which would start over 30 days ago. Choose a later end."
msgstr "Rentang waktu lebih pendek dari 61 menit dibaca sebagai 61 menit sebelum akhirnya, yang akan dimulai lebih dari 30 hari yang lalu. Pilih akhir lebih lambat."

msgid "DatabaseDiagnostics|Active session history"
msgstr "Riwayat sesi aktif"

msgid "DatabaseDiagnostics|All"
msgstr "Semua"

msgid "DatabaseDiagnostics|An average of 1 means one session was running or waiting for the whole hour, or two sessions for half of it."
msgstr "Rata-rata dari 1 artinya satu sesi telah berjalan atau menunggu selama satu jam penuh, atau dua sesi selama setengahnya."

msgid "DatabaseDiagnostics|An average of 1 means one session was running or waiting for the whole minute, or two sessions for half of it."
msgstr "Rata-rata dari 1 artinya satu sesi telah berjalan atau menunggu selama satu menit penuh, atau dua sesi selama setengahnya."

msgid "DatabaseDiagnostics|An error occurred while starting diagnostics"
msgstr "Terjadi galat ketika memulai diagnostik"

msgid "DatabaseDiagnostics|Anti-wraparound"
msgstr "Anti-pembungkus"

msgid "DatabaseDiagnostics|At least %{count} large table has no planner statistics, so PostgreSQL can choose bad query plans for it. Run ANALYZE with no table name, in a session with statement_timeout set to 0, to cover the whole database. It can take a long time."
msgid_plural "DatabaseDiagnostics|At least %{count} large tables have no planner statistics, so PostgreSQL can choose bad query plans for them. Run ANALYZE with no table name, in a session with statement_timeout set to 0, to cover the whole database. It can take a long time."
msgstr[0] "Setidaknya %{count} tabel besar tidak memiliki statistik perencana, jadi PostgreSQL dapat memilih rencana kueri buruk untuk mereka. Jalankan ANALYZE tanpa nama tabel, dalam sesi dengan statement_timeout diatur ke 0, untuk mencakup seluruh basis data. Itu dapat memakan waktu lama."

msgid "DatabaseDiagnostics|Autovacuum"
msgstr "Vakum otomatis"

msgid "DatabaseDiagnostics|Autovacuum configuration"
msgstr "Konfigurasi vakum otomatis"

msgid "DatabaseDiagnostics|Autovacuum disabled"
msgstr "Vakum otomatis dinonaktifkan"

msgid "DatabaseDiagnostics|Autovacuum is disabled for %{count} table, so its dead tuples are never reclaimed automatically."
