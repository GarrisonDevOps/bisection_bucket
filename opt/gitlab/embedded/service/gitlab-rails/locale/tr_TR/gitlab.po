msgstr "Bu, silinmiş kullanıcıların yazarı olduğu tüm issue'lar için oluşturulmuş bir \"Ghost User\"dır. Bu kullanıcı kaldırılamaz."

msgid "This is a %{emailsHelpLinkStart}private email address%{emailsHelpLinkEnd} generated just for you. Anyone who has it can create merge requests as if they were you. If that happens, %{resetLinkStart}reset this token%{resetLinkEnd}."
msgstr "Bu, yalnızca sizin için oluşturulmuş bir %{emailsHelpLinkStart}özel e-posta adresidir%{emailsHelpLinkEnd}. Adrese sahip olan herkes sizmiş gibi merge request oluşturabilir. Böyle bir durumda %{resetLinkStart}bu erişim anahtarını sıfırlayın%{resetLinkEnd}."

msgid "This is a %{role_type} role."
msgstr "Bu bir %{role_type} rolüdür."

msgid "This is a %{role_type}."
msgstr "Bu bir %{role_type}."

msgid "This is a Jira user."
msgstr "Bu bir Jira kullanıcısıdır."

