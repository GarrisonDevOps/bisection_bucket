#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative '../config/bundler_setup'
require_relative '../spec/simplecov_env_core'
require_relative 'coverage/as_if_foss_resultsets'
require 'etc'

SimpleCovEnvCore.configure_profile
SimpleCovEnvCore.configure_formatter

resultset_files = Dir.glob(File.join(SimpleCov.coverage_path, '*', '.resultset.json'))
exit(0) if resultset_files.empty?

rewritten = AsIfFossResultsets.new(root: SimpleCov.root).rewrite(resultset_files)
puts "Rewrote the gitlab-foss paths in #{rewritten} as-if-foss resultset(s)"

SimpleCov.collate(resultset_files, processes: Etc.nprocessors)
